# GitHub App credentials (create at github.com/settings/apps)
GITHUB_APP_ID=your_app_id
GITHUB_PRIVATE_KEY_PATH=./private-key.pem
GITHUB_WEBHOOK_SECRET=your_webhook_secret

# Groq API (free at console.groq.com)
GROQ_API_KEY=your_groq_api_key
# Optional: override the Groq model (default llama-3.1-8b-instant)
# GROQ_MODEL=llama-3.1-8b-instant

# Redis
REDIS_URL=redis://localhost:6379

# App
PORT=8000
LOG_LEVEL=INFO
ENVIRONMENT=development

# Post APPROVE / REQUEST_CHANGES reviews. Off by default: CodeSage then only
# ever leaves plain COMMENT reviews and never approves or blocks a merge.
# CODESAGE_POST_VERDICTS=true
