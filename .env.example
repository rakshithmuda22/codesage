# GitHub App credentials (create at github.com/settings/apps)
GITHUB_APP_ID=your_app_id
GITHUB_PRIVATE_KEY_PATH=./private-key.pem
GITHUB_WEBHOOK_SECRET=your_webhook_secret

# Groq API (free at console.groq.com)
GROQ_API_KEY=your_groq_api_key
# Optional: Groq model (default openai/gpt-oss-20b, Groq's recommended
# replacement for llama-3.1-8b-instant, which Groq shuts down on 2026-08-16).
# For gpt-oss models CodeSage sends reasoning_effort (default "low") and
# include_reasoning=false so the reply is just the JSON.
# GROQ_MODEL=openai/gpt-oss-20b
# GROQ_REASONING_EFFORT=low

# Redis
REDIS_URL=redis://localhost:6379

# App
PORT=8000
LOG_LEVEL=INFO
ENVIRONMENT=development

# Post APPROVE / REQUEST_CHANGES reviews. Off by default: CodeSage then only
# ever leaves plain COMMENT reviews and never approves or blocks a merge.
# CODESAGE_POST_VERDICTS=true
